<Window x:Class="BoxSend.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoxSend" Width="1000" Height="660" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 背景三层：主题渐变 -> 背景图片（透明度可调）-> 内容 -->
        <Grid Grid.RowSpan="2">
            <Rectangle Fill="{DynamicResource GradientBackground}" />
            <Image x:Name="Backdrop" Source="{DynamicResource BackgroundImage}"
                   Opacity="{DynamicResource BackgroundImageOpacity}" Stretch="UniformToFill" />
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="0" Margin="10,10,10,4" Background="Transparent"
                    BorderThickness="0">
            <TabItem x:Name="TabRun" Header="批量转种" />
            <TabItem x:Name="TabSites" Header="站点分组" />
            <TabItem x:Name="TabCookies" Header="Cookie" />
            <TabItem x:Name="TabDownloader" Header="下载器" />
            <TabItem x:Name="TabLogs" Header="日志" />
            <TabItem x:Name="TabSettings" Header="设置" />
        </TabControl>

        <Border Grid.Row="1" Background="{DynamicResource TextSurface}" Padding="12,6"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="RunState" DockPanel.Dock="Right" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextMuted}" FontSize="12" />
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextMuted}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
