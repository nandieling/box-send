<Window x:Class="BoxSend.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoxSend" Width="1000" Height="660" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" TextElement.FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 背景三层：主题渐变 -> 背景图片（透明度可调）-> 内容 -->
        <Grid Grid.RowSpan="2">
            <Rectangle Fill="{DynamicResource GradientBackground}" />
            <Image x:Name="Backdrop" Source="{DynamicResource BackgroundImage}"
                   Opacity="{DynamicResource BackgroundImageOpacity}" Stretch="UniformToFill" />
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="0" Margin="12,12,12,4" Background="Transparent"
                    BorderThickness="0">
            <TabItem x:Name="TabRun" />
            <TabItem x:Name="TabAssist" />
            <TabItem x:Name="TabSites" />
            <TabItem x:Name="TabSettings" />
        </TabControl>

        <!-- 底部提示条：cookie 同步信息之类，显示几分钟自己收（时长在核心 StickyMessage），
             末尾的「关闭」可以立刻收掉；没有内容就整条不占位，和 mac 版一条样 -->
        <Border x:Name="StatusBar" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource TextSurface}" Padding="12,6"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnDismissStatus" DockPanel.Dock="Right" Content="关闭"
                        Style="{StaticResource Ghost}" FontSize="12" Padding="8,2" Margin="12,0,0,0"
                        ToolTip="收起这条提示（cookie 提示几分钟后也会自己收）" Click="OnDismissStatus" />
                <TextBlock x:Name="StatusGlyph" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource TextMuted}" />
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
