<UserControl x:Class="BoxSend.Windows.Views.DownloaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BlockSurface}" CornerRadius="8" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <GroupBox Header="下载器（VPS 上的 qBittorrent / Transmission）">
                  <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                        <Label Content="类型" />
                        <ComboBox x:Name="Type" MinHeight="32">
                            <ComboBoxItem Content="qBittorrent" Tag="qbittorrent" />
                            <ComboBoxItem Content="Transmission" Tag="transmission" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <Label Content="地址（如 http://127.0.0.1:8080）" />
                        <TextBox x:Name="Url" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                        <Label Content="用户名" />
                        <TextBox x:Name="User" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Label Content="密码" />
                        <DockPanel>
                            <ToggleButton x:Name="Reveal" DockPanel.Dock="Right" Width="30" Content="👁"
                                          Checked="OnReveal" Unchecked="OnReveal" />
                            <PasswordBox x:Name="Pass" />
                        </DockPanel>
                        <TextBox x:Name="PassPeek" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                        <Label Content="保存路径（留空用下载器默认）" />
                        <TextBox x:Name="SavePath" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <Label Content="qBittorrent 分类" />
                        <TextBox x:Name="Category" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <Label Content="默认上传限速 MB/s" VerticalAlignment="Center" />
                    <TextBox x:Name="DefaultLimit" Width="60" VerticalAlignment="Center" />
                    <Label Content="推送时机" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <ComboBox x:Name="PushPolicy" Width="150" MinHeight="32" VerticalAlignment="Center">
                        <ComboBoxItem Content="转种成功就推" Tag="onSuccess" />
                        <ComboBoxItem Content="总是推" Tag="always" />
                    </ComboBox>
                    <CheckBox x:Name="SkipCheck" Content="跳过校验" Margin="16,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <Label Content="VPS 剩余空间（GB，留空不检查）" VerticalAlignment="Center" />
                    <TextBox x:Name="VpsFree" Width="60" VerticalAlignment="Center" />
                    <Label Content="不足时" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ComboBox x:Name="GuardMode" Width="110" MinHeight="32" VerticalAlignment="Center">
                        <ComboBoxItem Content="只提示" Tag="warn" />
                        <ComboBoxItem Content="跳过推送" Tag="skip" />
                    </ComboBox>
                    <Label Content="余量 GB" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox x:Name="GuardMargin" Width="50" VerticalAlignment="Center" />
                </WrapPanel>

                  </StackPanel>
                </GroupBox>

                <GroupBox Header="转种服务器（SSH 上传测速）">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="登录方式" />
                                <ComboBox x:Name="SshAuth">
                                    <ComboBoxItem Content="密钥（用系统 ssh）" Tag="key" />
                                    <ComboBoxItem Content="密码（用内置 SSH 客户端）" Tag="password" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="密码（只在登录方式选「密码」时用）" />
                                <PasswordBox x:Name="SshPass" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="服务器地址" />
                                <TextBox x:Name="SshHost" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <Label Content="SSH 端口" />
                                <TextBox x:Name="SshPort" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="用户名" />
                                <TextBox x:Name="SshUser" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="私钥路径（~ = 当前用户目录）" />
                                <TextBox x:Name="SshKeyPath" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <Label Content="每轮 MB" />
                                <TextBox x:Name="SshTestMB" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="测速地址（换成自己的接收端）" />
                                <TextBox x:Name="SshProbe" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="BtnSshTest" Content="测试连接并测速"
                                    Style="{StaticResource Primary}" Click="OnTestSSH" />
                            <TextBlock x:Name="SshState" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}" />
                        </WrapPanel>
                        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="「转种前先测上传速度」的开关在「批量转种」页「开始运行」旁边。密钥登录用系统自带的 ssh：先在 C:\Windows\System32\OpenSSH 下执行 ssh-keygen 生成密钥，再把公钥追加到服务器的 ~/.ssh/authorized_keys。密码登录走软件内置的 SSH 客户端，不需要系统 ssh。测速是在服务器上往公网推数据（默认每轮 64 MB、共两轮），只多花这一份上行。" />
                    </StackPanel>
                </GroupBox>

                <WrapPanel Margin="0,16,0,0">
                    <Button Content="保存" Style="{StaticResource Primary}" Click="OnSave" />
                    <Button Content="测试连接" Margin="10,0,0,0" Click="OnTest" />
                    <TextBlock x:Name="Result" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" FontSize="12" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
