<UserControl x:Class="BoxSend.Windows.Views.SitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BlockSurface}" CornerRadius="8" Padding="16">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="添加转种分组和站点" FontWeight="SemiBold"
                       Margin="0,0,0,8" Foreground="{DynamicResource TextMuted}" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Label Content="分组名" VerticalAlignment="Center" />
                <TextBox x:Name="NewGroupName" Width="190" VerticalAlignment="Center" />
                <Label Content="上传限速" Margin="10,0,4,0" VerticalAlignment="Center" />
                <TextBox x:Name="NewGroupMB" Width="116" Text="10" VerticalAlignment="Center"
                         TextAlignment="Center"
                         ToolTip="组内新增站点的默认上传限速 MB/s，0 = 不限速" />
                <Label Content="MB/s" VerticalAlignment="Center" />
                <Button x:Name="BtnAddGroup" Content="添加分组" Margin="8,0,0,0" Click="OnAddGroup" />
                <Button x:Name="BtnSync" Content="同步 Cookie" Margin="12,0,0,0" Click="OnSyncCookies"
                        ToolTip="同时同步 PT-depiler Gist 与 CookieCloud 两路 cookie 备份" />
                <Button x:Name="BtnCheckAll" Content="检测全部 cookie" Margin="12,0,0,0" Click="OnCheckAll" />
                <Button x:Name="BtnStopCheck" Content="停止检测" Margin="8,0,0,0" Visibility="Collapsed"
                        Click="OnStopCheck" />
                <TextBlock x:Name="Hint" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" FontSize="12" />
            </WrapPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Blocks" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
