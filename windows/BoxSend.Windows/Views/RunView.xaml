<UserControl x:Class="BoxSend.Windows.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Background="{DynamicResource BlockSurface}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="种子链接" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <!-- 源站种子的获取状态（转种时源站种子也一起推下载器）-->
                        <Border x:Name="SourceChip" DockPanel.Dock="Right" CornerRadius="9"
                                Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="{DynamicResource TextSurface}" Visibility="Collapsed">
                            <TextBlock x:Name="SourceChipText" FontSize="12" TextWrapping="NoWrap" />
                        </Border>
                        <ComboBox x:Name="SourceSitePick" DockPanel.Dock="Right" Width="200" MinHeight="32"
                                  VerticalAlignment="Center"
                                  ToolTip="默认按链接域名识别源站；已添加的站点都能点名作源站（站点换过域名、或同一站点有多个入口时用得上）" />
                        <Border DockPanel.Dock="Right" Width="10" Background="Transparent" />
                        <TextBox x:Name="DetailUrl" MinHeight="34" FontSize="13"
                                 VerticalContentAlignment="Center"
                                 ToolTip="粘贴种子详情页链接（如 https://…/details.php?id=…）" />
                    </DockPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="UseQuote" Content="源站引用" VerticalAlignment="Center"
                                  Click="OnQuoteToggled"
                                  ToolTip="源站简介自带引用时不用勾选；勾选后这段文字会加在每个目标站简介最上面，并用引用块包起来" />
                        <Border Width="8" Background="Transparent" />
                        <TextBox x:Name="QuoteText" Width="440" MinHeight="32"
                                 VerticalContentAlignment="Center"
                                 ToolTip="加在简介最上面的引用文本（如：转载自LuckPT，感谢发布者）" />
                    </WrapPanel>
                    <TextBlock x:Name="QuoteHint" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed" Foreground="{DynamicResource Warning}" />
                    <WrapPanel Margin="0,12,0,0">
                        <CheckBox x:Name="DoReseed" Content="转种到目标站" IsChecked="True"
                                  VerticalAlignment="Center" />
                        <Border Width="14" Background="Transparent" />
                        <CheckBox x:Name="DoPush" Content="推送到下载器" IsChecked="True"
                                  VerticalAlignment="Center" />
                        <Border Width="14" Background="Transparent" />
                        <!-- 测速按钮挨着「开始运行」：服务器地址等仍填在「下载器」页那张卡片 -->
                        <Button x:Name="BtnSpeed" Content="测试上传速度" Click="OnSpeedTest"
                                Padding="12,5,12,5"
                                ToolTip="到服务器上量一次公网上行，实测速度显示在下一行；服务器信息填在「下载器」页的「转种服务器」卡片里" />
                        <Border Width="14" Background="Transparent" />
                        <Button x:Name="BtnRun" Content="开始运行" Style="{StaticResource Primary}"
                                Click="OnRun" Padding="16,5,16,5"
                                ToolTip="测不测速都能直接开转；想知道服务器有没有被限速，点左边的「测试上传速度」" />
                        <Border Width="14" Background="Transparent" />
                        <TextBlock x:Name="BatchSummary" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextMuted}" />
                        <Border Width="14" Background="Transparent" />
                        <TextBlock x:Name="RunStep" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" />
                    </WrapPanel>
                    <!-- 测速结果单独一行：跑完就留在这儿，不弹窗挡「开始运行」 -->
                    <TextBlock x:Name="SpeedResult" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
            </Border>

            <TextBlock Text="转种分组" FontWeight="SemiBold" Margin="2,16,0,0" />
            <TextBlock FontSize="12" Margin="2,2,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="按分组先后执行；点卡片选为转种目标（再点取消），组名旁的按钮整组全选或全不选。卡片上实时显示转种与推送结果。" />
            <StackPanel x:Name="TargetBlocks" Margin="0,10,0,0" />

            <Button x:Name="BtnHistory" Content="运行记录" Margin="2,14,0,0"
                    HorizontalAlignment="Left" Click="OnHistory" />
            <Border x:Name="HistoryBox" Visibility="Collapsed" Margin="0,8,0,0"
                    Background="{DynamicResource TextSurface}" CornerRadius="8" Padding="12">
                <TextBlock x:Name="HistoryText" FontFamily="Consolas, Microsoft YaHei" FontSize="12"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"
                           Text="（还没有运行记录）" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
