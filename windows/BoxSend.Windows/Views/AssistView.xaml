<UserControl x:Class="BoxSend.Windows.Views.AssistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BlockSurface}" CornerRadius="8" Padding="16">
        <DockPanel LastChildFill="True">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button x:Name="BtnScan" Content="扫描下载器" Click="OnScan" />
                <Button x:Name="BtnStart" Content="开始辅种" Style="{StaticResource Primary}"
                        Margin="10,0,0,0" Click="OnStart" />
                <CheckBox x:Name="DryRun" Content="只预演" VerticalAlignment="Center"
                          Margin="14,0,0,0" ToolTip="按真实流程走一遍，但不动下载器" />
                <TextBlock x:Name="State" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                           Foreground="{DynamicResource TextMuted}" />
            </WrapPanel>

            <TextBlock x:Name="SiteInfo" DockPanel.Dock="Top" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,8" Foreground="{DynamicResource TextMuted}" />

            <!-- 整轮计数：已完成辅种 / 待辅种 / 失败辅种…（核心库算好连标签一起给） -->
            <GroupBox DockPanel.Dock="Top" Header="辅种统计">
                <StackPanel>
                    <ItemsControl x:Name="Stats">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MinWidth="98" Margin="0,0,18,2">
                                    <TextBlock Text="{Binding Count}" FontSize="22" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Success">
                                                        <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="DangerText">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Accent">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="PlanSummary" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
            </GroupBox>

            <!-- 一条种子一张卡，卡里是它在各辅种站的格子：站名 + 已辅种 / 待辅种 / 不存在 -->
            <GroupBox Header="种子与站点" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock x:Name="TorrentHint" DockPanel.Dock="Top" FontSize="12" Margin="0,0,0,6"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Torrents">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Right}"
                                                       FontSize="12" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding Left}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Cells}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="152" Margin="0,0,8,8" Padding="8,6"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource BlockSurface}"
                                                            BorderBrush="{DynamicResource Line}"
                                                            BorderThickness="1" ToolTip="{Binding Tip}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding SiteName}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                           FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Tone}" Value="Success">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tone}" Value="DangerText">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tone}" Value="Accent">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <!-- 人比对过觉得是同一种子，就按人的判断走一遍推送（校验不满照样回滚） -->
                                                                <Button Content="采纳" FontSize="11" Padding="7,0"
                                                                        Margin="6,0,0,0" Click="OnAdopt"
                                                                        ToolTip="按人工判断当成同一种子：加进下载器，校验到 100% 才算辅成">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding NeedConfirm}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </DockPanel>
    </Border>
</UserControl>
