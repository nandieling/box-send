<UserControl x:Class="BoxSend.Windows.Views.CookiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BoxSend.Windows">
    <StackPanel>
        <TextBlock Text="Cookie 同步与导入" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />

        <GroupBox Header="PT-depiler Gist 同步">
            <StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="320" HorizontalAlignment="Left">
                    <Label Content="Gist ID" Padding="0,0,0,2" />
                    <TextBox x:Name="GistId" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left">
                    <Label Content="GitHub Token" Padding="0,0,0,2" />
                    <local:SecretField x:Name="GistToken" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left">
                    <Label Content="加密 KEY" Padding="0,0,0,2" />
                    <local:SecretField x:Name="GistKey" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="120" HorizontalAlignment="Left">
                    <Label Content="自动同步间隔（分钟）" Padding="0,0,0,2" />
                    <TextBox x:Name="GistPoll" />
                </StackPanel>
                <WrapPanel Margin="0,2,0,0">
                    <CheckBox x:Name="GistAuto" Content="开启自动同步" VerticalAlignment="Center" Click="OnGistAuto" />
                    <Button x:Name="BtnGist" Content="立即同步" Margin="12,0,0,0"
                            Style="{StaticResource Primary}" Click="OnSyncGist" />
                    <Button x:Name="BtnSaveGist" Content="保存" Margin="8,0,0,0" Click="OnSaveGist" />
                    <TextBlock x:Name="GistState" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                               Foreground="{DynamicResource TextMuted}" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="CookieCloud 同步">
            <StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="420" HorizontalAlignment="Left">
                    <Label Content="服务器地址" Padding="0,0,0,2" />
                    <TextBox x:Name="CcHost" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left">
                    <Label Content="KEY" Padding="0,0,0,2" />
                    <local:SecretField x:Name="CcKey" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left">
                    <Label Content="端对端加密密码" Padding="0,0,0,2" />
                    <local:SecretField x:Name="CcPassword" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="120" HorizontalAlignment="Left">
                    <Label Content="间隔（分钟）" Padding="0,0,0,2" />
                    <TextBox x:Name="CcPoll" />
                </StackPanel>
                <WrapPanel Margin="0,2,0,0">
                    <CheckBox x:Name="CcAuto" Content="自动同步" VerticalAlignment="Center" Click="OnCookieCloudAuto" />
                    <Button x:Name="BtnCc" Content="立即同步" Margin="12,0,0,0"
                            Style="{StaticResource Primary}" Click="OnSyncCookieCloud" />
                    <Button Content="保存" Margin="8,0,0,0" Click="OnSaveCookieCloud" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="PT-depiler 本地备份（PTD_backup_*.zip）">
            <StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="470" HorizontalAlignment="Left">
                    <Label Content="备份目录" Padding="0,0,0,2" />
                    <DockPanel>
                        <Button Content="选择目录…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnPickZipDir" />
                        <TextBox x:Name="ZipDir" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="300" HorizontalAlignment="Left">
                    <Label Content="备份密码" Padding="0,0,0,2" />
                    <local:SecretField x:Name="ZipPassword" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8" MaxWidth="120" HorizontalAlignment="Left">
                    <Label Content="扫描间隔（分钟）" Padding="0,0,0,2" />
                    <TextBox x:Name="ZipPoll" />
                </StackPanel>
                <WrapPanel Margin="0,2,0,0">
                    <CheckBox x:Name="ZipAuto" Content="自动扫描" VerticalAlignment="Center" Click="OnZipAuto" />
                    <Button Content="立即扫描" Margin="12,0,0,0" Click="OnZipScan" />
                    <Button Content="保存" Margin="8,0,0,0" Click="OnSaveZip" />
                    <Button Content="清空本地 cookie" Margin="12,0,0,0" Click="OnClear"
                            ToolTip="清掉本机存的全部 cookie；同步一次可以重新拉取" />
                </WrapPanel>
                <TextBlock x:Name="CookieMessage" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
