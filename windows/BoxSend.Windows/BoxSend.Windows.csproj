<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
                <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BoxSend</AssemblyName>
    <RootNamespace>BoxSend.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- 让 macOS/Linux 也能编译校验（不产出可运行的 Windows 界面） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 打包默认自包含（用户无需装 .NET），这里的 false 只是本地裸 build 的省事默认；
         build.ps1 用命令行参数覆盖，命令行优先级高于工程属性 -->
    <SelfContained>false</SelfContained>
    <!-- 万一用了 -FrameworkDependent，装了 .NET 9/10 桌面运行时的机器也能直接跑 -->
    <RollForward>Major</RollForward>
    <ApplicationIcon Condition="Exists('boxsend.ico')">boxsend.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 核心库：由 Swift 工具链产出 boxsend-core.dll + Swift 运行时 DLL，整目录带进输出 -->
  <ItemGroup>
    <!-- Link 不带目录 = 拍平到输出根目录。dotnet 默认会保留 native\ 这层，而核心库的依赖
         （swiftCore.dll 那一堆）是运行期动态加载的，Windows 只在「exe 所在目录 + PATH」里找 -->
    <None Include="native\**\*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('assets')" />
    <!-- 运行时按文件读图标（任务栏/托盘），exe 里那份是文件管理器看的 -->
    <Content Include="boxsend.ico" CopyToOutputDirectory="PreserveNewest" Condition="Exists('boxsend.ico')" />
  </ItemGroup>

</Project>
